# Database connection URL (defaults to local SQLite database in app directory)
# For production PostgreSQL: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./inventory.db

# Secret key for signing JWT authentication tokens
JWT_SECRET=9f8a37b12d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9

# Comma-separated list of allowed CORS origins in production (e.g. https://stockpulse.com,https://api.stockpulse.com)
# Defaults to "*" if not specified or set to "*"
ALLOWED_ORIGINS=*
